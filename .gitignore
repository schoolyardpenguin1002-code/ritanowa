# See https://help.github.com/articles/ignoring-files/

# ─── dependencies ───
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ───
.next/
out/
build/
dist/

# ─── testing ───
coverage/
.nyc_output/

# ─── environment / secrets（GitHub に上げない）───
# テンプレートだけコミットする場合は .env.example を用意し、下の除外から外す
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Vercel / deploy ───
.vercel
.turbo

# ─── debug & logs ───
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ─── OS & editor ───
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── TypeScript ───
*.tsbuildinfo

# ─── misc ───
*.swp
*.swo
.cache/
